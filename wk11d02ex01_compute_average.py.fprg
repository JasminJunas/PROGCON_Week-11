<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="progcon shits"/>
        <attribute name="authors" value="JJ"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-28 10:04:58 AM"/>
        <attribute name="created" value="Sko7REVTS1RPUC1WTk1KTzZKOzIwMjYtMDktMjY7MDU6NDA6MjEgUE07MjUzNg=="/>
        <attribute name="edited" value="Sko7REVTS1RPUC1WTk1KTzZKOzIwMjYtMDktMjg7MTA6MDQ6NTggQU07MjsyNjM4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body/>
    </function>
    <function name="computeAverage" type="Real" variable="">
        <parameters>
            <parameter name="numbers" type="Real" array="True"/>
        </parameters>
        <body>
            <declare name="total" type="Integer" array="False" size=""/>
            <assign variable="total" expression="0"/>
            <declare name="count" type="Integer" array="False" size=""/>
            <declare name="num" type="Real" array="False" size=""/>
            <assign variable="count" expression="0"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="3" direction="inc" step="1">
                <declare name="num" type="Integer" array="False" size=""/>
                <assign variable="num" expression="numbers[i]"/>
                <if expression="num = 0">
                    <then>
                        <assign variable="total" expression="total + num"/>
                        <assign variable="count" expression="count + 1"/>
                    </then>
                    <else>
                        <assign variable="total" expression="total + num"/>
                        <assign variable="count" expression="count + 1"/>
                    </else>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>
