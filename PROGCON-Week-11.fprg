<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="PROGCON-Week-11"/>
        <attribute name="authors" value="Jasmin Junas"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-01 03:55:45 PM"/>
        <attribute name="created" value="SmFzbWluIEp1bmFzO0xBUFRPUC1SUDhWMlJSUjsyMDI2LTEwLTAxOzAyOjU0OjUwIFBNOzM1MzY="/>
        <attribute name="edited" value="SmFzbWluIEp1bmFzO0xBUFRPUC1SUDhWMlJSUjsyMDI2LTEwLTAxOzAzOjU1OjQ1IFBNOzE7MzY1MA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="result" type="Real" array="False" size=""/>
            <declare name="numbers" type="Integer" array="True" size="4"/>
            <assign variable="numbers[0]" expression="22"/>
            <assign variable="numbers[1]" expression="9"/>
            <assign variable="numbers[2]" expression="0"/>
            <assign variable="numbers[3]" expression="17"/>
            <assign variable="result" expression="computeAverage(numbers)"/>
            <output expression="result" newline="True"/>
            <assign variable="numbers[0]" expression="22"/>
            <assign variable="numbers[1]" expression="0"/>
            <assign variable="numbers[2]" expression="49"/>
            <assign variable="numbers[3]" expression="8"/>
            <assign variable="result" expression="computeAverage(numbers)"/>
            <output expression="result" newline="True"/>
            <assign variable="numbers[0]" expression="35"/>
            <assign variable="numbers[1]" expression="13"/>
            <assign variable="numbers[2]" expression="22"/>
            <assign variable="numbers[3]" expression="0"/>
            <assign variable="result" expression="computeAverage(numbers)"/>
            <output expression="result" newline="True"/>
            <assign variable="numbers[0]" expression="10"/>
            <assign variable="numbers[1]" expression="5"/>
            <assign variable="numbers[2]" expression="-4"/>
            <assign variable="numbers[3]" expression="27"/>
            <assign variable="result" expression="computeAverage(numbers)"/>
            <output expression="result" newline="True"/>
        </body>
    </function>
    <function name="computeAverage" type="Real" variable="result">
        <parameters>
            <parameter name="numbers" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="result" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <declare name="count" type="Integer" array="False" size=""/>
            <declare name="index" type="Integer" array="False" size=""/>
            <assign variable="total" expression="0"/>
            <assign variable="count" expression="0"/>
            <assign variable="index" expression="0"/>
            <while expression="index &lt; 4">
                <if expression="numbers[index] = 0">
                    <then>
                        <assign variable="index" expression="4"/>
                    </then>
                    <else>
                        <assign variable="total" expression="total + numbers[index]"/>
                        <assign variable="count" expression="count + 1"/>
                        <assign variable="index" expression="index + 1"/>
                    </else>
                </if>
            </while>
            <assign variable="result" expression="total / count"/>
        </body>
    </function>
</flowgorithm>
