<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="PROGCON-Week-11"/>
        <attribute name="authors" value="Jasmin Junas"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-01 02:32:03 PM"/>
        <attribute name="created" value="SmFzbWluIEp1bmFzO0xBUFRPUC1SUDhWMlJSUjsyMDI2LTEwLTAxOzAyOjIxOjQxIFBNOzM1MzA="/>
        <attribute name="edited" value="SmFzbWluIEp1bmFzO0xBUFRPUC1SUDhWMlJSUjsyMDI2LTEwLTAxOzAyOjMyOjAzIFBNOzE7MzYzOA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body/>
    </function>
    <function name="computeAverage" type="Real" variable="result">
        <parameters>
            <parameter name="numbers" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="result" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <declare name="count" type="Integer" array="False" size=""/>
            <declare name="index" type="Integer" array="False" size=""/>
            <assign variable="total" expression="0"/>
            <assign variable="count" expression="0"/>
            <assign variable="index" expression="0"/>
            <while expression="index &lt; 4">
                <if expression="numbers[index] = 0">
                    <then>
                        <assign variable="result" expression="total / count"/>
                    </then>
                    <else>
                        <assign variable="total" expression="total + numbers[index]"/>
                        <assign variable="count" expression="count + 1"/>
                        <assign variable="index" expression="index + 1"/>
                    </else>
                </if>
            </while>
            <assign variable="result" expression="total / count"/>
        </body>
    </function>
</flowgorithm>
